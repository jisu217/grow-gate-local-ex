spring:
  datasource:
    url: jdbc:mysql://localhost:3306/growgate?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&characterEncoding=UTF-8
    username: root
    password: YOUR_DB_PASSWORD
    driver-class-name: com.mysql.cj.jdbc.Driver
  jpa:
    hibernate:
      ddl-auto: ${JPA_DDL_AUTO:validate}
    show-sql: false
    properties:
      hibernate:
        dialect: org.hibernate.dialect.MySQL8Dialect
        format_sql: true
  jackson:
    time-zone: UTC
    serialization:
      write-dates-as-timestamps: false

jwt:
  secret: YOUR_32_BYTE_OR_BASE64_32_BYTE_JWT_SECRET
  expiration: 86400000

app:
  cors:
    allowed-origins: ${APP_CORS_ORIGINS:http://localhost:3000,http://localhost:5173,http://localhost:5174,http://localhost:8765,http://localhost:8000}
  fastapi:
    enabled: ${APP_FASTAPI_ENABLED:false}
    base-url: ${APP_FASTAPI_BASE_URL:http://localhost:8000}
  agent:
    enabled: ${APP_AGENT_ENABLED:false}
    budget:
      max-daily-requests-per-user: ${APP_AGENT_MAX_DAILY_REQUESTS_PER_USER:30}
      max-daily-requests-global: ${APP_AGENT_MAX_DAILY_REQUESTS_GLOBAL:300}
      max-prompt-chars: ${APP_AGENT_MAX_PROMPT_CHARS:12000}
      max-output-tokens: ${APP_AGENT_MAX_OUTPUT_TOKENS:1024}
    gemini:
      enabled: ${APP_AGENT_GEMINI_ENABLED:true}
      api-key: ${APP_AGENT_GEMINI_API_KEY:}
      model: ${APP_AGENT_GEMINI_MODEL:gemini-2.5-flash}
      base-url: ${APP_AGENT_GEMINI_BASE_URL:https://generativelanguage.googleapis.com/v1beta}
    openrouter:
      enabled: ${APP_AGENT_OPENROUTER_ENABLED:true}
      api-key: ${APP_AGENT_OPENROUTER_API_KEY:}
      model: ${APP_AGENT_OPENROUTER_MODEL:google/gemini-2.5-flash}
      url: ${APP_AGENT_OPENROUTER_URL:https://openrouter.ai/api/v1/chat/completions}
      site-url: ${APP_AGENT_OPENROUTER_SITE_URL:${APP_PUBLIC_SITE_URL:}}
      app-title: ${APP_AGENT_OPENROUTER_APP_TITLE:GrowGate Local EX}
  auth:
    cookie-secure: ${APP_AUTH_COOKIE_SECURE:false}
  demo-admin:
    enabled: ${APP_DEMO_ADMIN_ENABLED:false}
    email: ${APP_DEMO_ADMIN_EMAIL:admin@growgate.com}
    name: ${APP_DEMO_ADMIN_NAME:김지용}
    password-hash: ${APP_DEMO_ADMIN_PASSWORD_HASH:}
  google-sso:
    enabled: ${GOOGLE_SSO_ENABLED:false}
    client-id: ${GOOGLE_SSO_CLIENT_ID:}

public-data:
  enabled: ${PUBLIC_DATA_ENABLED:true}
  cache-ttl-hours: ${PUBLIC_DATA_CACHE_TTL_HOURS:24}
  daily-refresh:
    enabled: ${PUBLIC_DATA_DAILY_REFRESH_ENABLED:true}
    cron: ${PUBLIC_DATA_DAILY_REFRESH_CRON:0 0 8 * * *}
    zone: ${PUBLIC_DATA_DAILY_REFRESH_ZONE:Asia/Seoul}
    max-products: ${PUBLIC_DATA_DAILY_REFRESH_MAX_PRODUCTS:30}
    freshness-hours: ${PUBLIC_DATA_DAILY_REFRESH_FRESHNESS_HOURS:20}
  crawl:
    enabled: ${PUBLIC_DATA_CRAWL_ENABLED:false}
    urls: ${PUBLIC_DATA_CRAWL_URLS:}
    allowed-hosts: ${PUBLIC_DATA_CRAWL_ALLOWED_HOSTS:www.motie.go.kr,motie.go.kr,www.kotra.or.kr,dream.kotra.or.kr,www.safetykorea.kr,www.data.go.kr}
  export-evidence:
    enabled: ${PUBLIC_DATA_EXPORT_EVIDENCE_ENABLED:false}
    urls: ${PUBLIC_DATA_EXPORT_EVIDENCE_URLS:}
    allowed-hosts: ${PUBLIC_DATA_EXPORT_EVIDENCE_ALLOWED_HOSTS:www.motie.go.kr,motie.go.kr,dream.kotra.or.kr,www.kotra.or.kr,eiec.kdi.re.kr,www.kiet.re.kr,www.kita.net}
  kcs-trade:
    url: ${KCS_TRADE_API_URL:http://apis.data.go.kr/1220000/Newtrade/getNewtradeList}
    key: ${KCS_TRADE_API_KEY:${DATAGO_SERVICE_KEY:}}
  kcs-tariff-logistics:
    csv-resource: ${KCS_TARIFF_LOGISTICS_CSV_RESOURCE:classpath:publicdata/kcs-tariff-logistics-reference-20260531.csv}
    dataset-date: ${KCS_TARIFF_LOGISTICS_DATASET_DATE:2026-05-31}
    source-hs-date: ${KCS_TARIFF_LOGISTICS_SOURCE_HS_DATE:2026-01-01}
    source-tariff-date: ${KCS_TARIFF_LOGISTICS_SOURCE_TARIFF_DATE:2026-02-11}
  kotra-market:
    url: ${KOTRA_MARKET_API_URL:https://www.data.go.kr/data/15122648/openapi.do}
    key: ${KOTRA_MARKET_API_KEY:${DATAGO_SERVICE_KEY:}}
  kiat-rnd-outcomes:
