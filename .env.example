# GROW-GATE local production-like compose settings.
# Copy to .env for local use. Do not commit real API keys.

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=growgate_root
MYSQL_DATABASE=growgate
MYSQL_USER=growgate_app
MYSQL_PASSWORD=growgate_app

BACKEND_PORT=8080
FRONTEND_PORT=5173
JPA_DDL_AUTO=update
JWT_SECRET=unsafe-local-demo-secret-change-before-prod-32bytes
APP_VERSION=docker-local
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:8080,http://localhost:3000

PUBLIC_DATA_ENABLED=true
PUBLIC_DATA_CONNECT_TIMEOUT_MS=3000
PUBLIC_DATA_READ_TIMEOUT_MS=20000
PUBLIC_DATA_RETRY_MAX_ATTEMPTS=2
PUBLIC_DATA_CIRCUIT_FAILURE_THRESHOLD=3
PUBLIC_DATA_CIRCUIT_OPEN_SECONDS=60

# Shared data.go.kr key. Leave blank to return sourceType=empty and zeroReason=API_KEY_NOT_CONFIGURED.
DATAGO_SERVICE_KEY=

# Provider-specific keys override DATAGO_SERVICE_KEY where applicable.
KCS_TRADE_API_KEY=
KOTRA_MARKET_API_KEY=
SAFETY_RECALL_API_KEY=
MOTIE_IMPORT_REGULATION_API_KEY=
MOTIE_MPE_TRADE_STATISTICS_API_KEY=
MOTIE_MPE_PRODUCTION_INDEX_API_KEY=
TRADE_SECURITY_HSK_LINKAGE_API_KEY=
TRADE_SECURITY_ITEM_KEYWORD_API_KEY=
KIPRIS_API_KEY=
KIPRIS_PLUS_ACCESSKEY=${KIPRIS_API_KEY}
BIZINFO_API_KEY=

# Operation endpoints. Defaults include several catalog/application pages and are not counted as live proof.
KCS_TRADE_API_URL=http://apis.data.go.kr/1220000/Newtrade/getNewtradeList
KCS_TARIFF_LOGISTICS_CSV_RESOURCE=classpath:publicdata/kcs-tariff-logistics-reference-20260531.csv
KCS_TARIFF_LOGISTICS_FILE_PATH=data/public/kcs_tariff_logistics_reference_20260531.csv
KCS_TARIFF_LOGISTICS_FILE_AS_OF=2026-05-31
KCS_TARIFF_LOGISTICS_NEXT_UPDATE_DUE_AT=2026-07-31
KOTRA_MARKET_API_URL=https://www.data.go.kr/data/15122648/openapi.do
SAFETY_RECALL_API_URL=https://www.safetykorea.kr/release/openapi
MOTIE_IMPORT_REGULATION_API_URL=https://api.odcloud.kr/api/3039436/v1/uddi:e460a8d2-9074-45b1-b5eb-c3cd169cbe2a_201703291030
MOTIE_IMPORT_REGULATION_CSV_RESOURCE=classpath:publicdata/motie-import-regulations-20260508.csv
MOTIE_IMPORT_REGULATION_NEXT_UPDATE_DATE=2027-05-14
MOTIE_MPE_TRADE_STATISTICS_API_URL=https://api.odcloud.kr/api/15099627/v1/uddi:64f277d4-70bb-49a7-bb50-a4d56466ea3e
MOTIE_MPE_TRADE_STATISTICS_CSV_RESOURCE=classpath:publicdata/motie-mpe-trade-statistics-20251231.csv
MOTIE_MPE_TRADE_STATISTICS_NEXT_UPDATE_DATE=2027-06-17
MOTIE_MPE_PRODUCTION_INDEX_API_URL=https://api.odcloud.kr/api/15099628/v1/uddi:811bd1e3-f6f3-43ef-99ee-9f7d767f94b3
MOTIE_MPE_PRODUCTION_INDEX_CSV_RESOURCE=classpath:publicdata/motie-mpe-production-index-20251231.csv
MOTIE_MPE_PRODUCTION_INDEX_NEXT_UPDATE_DATE=2026-06-27
TRADE_SECURITY_HSK_LINKAGE_API_URL=https://api.odcloud.kr/api/15034135/v1/uddi:80b756b5-9d5f-4369-8a38-ad5ac43534e5
TRADE_SECURITY_HSK_LINKAGE_CSV_RESOURCE=classpath:publicdata/trade-security-hsk-linkage-20260522.csv
TRADE_SECURITY_HSK_LINKAGE_NEXT_UPDATE_DATE=2027-05-22
TRADE_SECURITY_ITEM_KEYWORD_API_URL=https://api.odcloud.kr/api/15042113/v1/uddi:40a03829-dfb8-4e40-b6c5-e10345ee462d
TRADE_SECURITY_ITEM_KEYWORD_CSV_RESOURCE=classpath:publicdata/trade-security-item-keywords-20260522.csv
TRADE_SECURITY_ITEM_KEYWORD_NEXT_UPDATE_DATE=2027-05-22
KIPRIS_PLUS_OPERATION_URL=http://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getAdvancedSearch
KIPRIS_PLUS_KEY_PARAM=ServiceKey
KIPRIS_PLUS_PAGE_SIZE=10
KIPRIS_API_URL=${KIPRIS_PLUS_OPERATION_URL}
BIZINFO_API_URL=https://www.exportvoucher.com/
