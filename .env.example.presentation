MOTIE_RECALL_DISPOSITIONS_API_URL=replace-with-swagger-operation-endpoint-from-15054301-v1-if-updated
MOTIE_RECALL_DISPOSITIONS_API_KEY=${DATAGO_SERVICE_KEY}
MOTIE_SAFETY_CERT_NEW_REGISTRATIONS_SOURCE_URL=https://www.data.go.kr/data/15054302/fileData.do
