# GrowGate presentation/server environment template
# Copy values into your deployment secret store. Do not commit real keys.

PRESENTATION_MODE=true
REQUIRE_LIVE_PUBLIC_DATA=true
PUBLIC_DATA_ENABLED=true

# Frontend
VITE_APP_MODE=presentation
VITE_ENABLE_MOCK=false
VITE_PRESENTATION_MODE=true
VITE_API_BASE_URL=https://your-growgate-domain.example/api
# Backward-compatible alias. FE prefers VITE_API_URL when both are present.
VITE_API_URL=https://your-growgate-domain.example/api

# Backend core
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=https://your-growgate-domain.example
JWT_SECRET=replace-with-32-byte-random-secret
DB_URL=jdbc:mysql://localhost:3306/growgate
DB_USERNAME=growgate
DB_PASSWORD=replace-with-db-password
JPA_DDL_AUTO=validate

# Public data live API keys/endpoints
DATAGO_SERVICE_KEY=replace-with-data-go-kr-service-key
KCS_TRADE_API_URL=http://apis.data.go.kr/1220000/Newtrade/getNewtradeList
KCS_TRADE_API_KEY=${DATAGO_SERVICE_KEY}
KOTRA_MARKET_API_URL=replace-with-approved-kotra-operation-endpoint
KOTRA_MARKET_API_KEY=replace-with-kotra-key
SAFETY_RECALL_API_URL=replace-with-safetykorea-operation-endpoint
SAFETY_RECALL_API_KEY=replace-with-safetykorea-key
KIPRIS_API_URL=replace-with-kipris-plus-operation-endpoint
KIPRIS_API_KEY=replace-with-kipris-plus-key
BIZINFO_API_URL=replace-with-bizinfo-operation-endpoint
BIZINFO_API_KEY=replace-with-bizinfo-key

# Optional safe public web crawl. Keep disabled unless URLs are reviewed.
PUBLIC_DATA_CRAWL_ENABLED=false
PUBLIC_DATA_CRAWL_URLS=
PUBLIC_DATA_CRAWL_ALLOWED_HOSTS=www.motie.go.kr,motie.go.kr,www.kotra.or.kr,dream.kotra.or.kr,www.safetykorea.kr,www.data.go.kr

# Optional export news/report RSS or JSON feeds. This is not official API scoring;
# it is capped external evidence for freshness/context and is sourceType=external_feed.
PUBLIC_DATA_EXPORT_EVIDENCE_ENABLED=false
PUBLIC_DATA_EXPORT_EVIDENCE_URLS=
PUBLIC_DATA_EXPORT_EVIDENCE_ALLOWED_HOSTS=www.motie.go.kr,motie.go.kr,dream.kotra.or.kr,www.kotra.or.kr,eiec.kdi.re.kr,www.kiet.re.kr,www.kita.net

# Optional LLM assistant. Gate scoring must still work when disabled.
APP_AGENT_ENABLED=false
APP_AGENT_MAX_DAILY_REQUESTS_PER_USER=30
APP_AGENT_MAX_DAILY_REQUESTS_GLOBAL=300
APP_AGENT_MAX_PROMPT_CHARS=12000
APP_AGENT_MAX_OUTPUT_TOKENS=1024
APP_AGENT_GEMINI_ENABLED=true
APP_AGENT_GEMINI_API_KEY=replace-with-google-gemini-key
APP_AGENT_GEMINI_MODEL=gemini-2.5-flash
APP_AGENT_OPENROUTER_ENABLED=true
APP_AGENT_OPENROUTER_API_KEY=replace-with-openrouter-key
APP_AGENT_OPENROUTER_MODEL=google/gemini-2.5-flash

# Optional Google Sign-In. Keep disabled unless OAuth consent screen,
# privacy policy URL, authorized origins, and server-side ID token verification are ready.
GOOGLE_SSO_ENABLED=false
GOOGLE_SSO_CLIENT_ID=replace-with-google-oauth-client-id

# Smoke-test controls
BASE_URL=https://your-growgate-domain.example
SMOKE_CORS_ORIGIN=https://your-growgate-domain.example
SMOKE_REQUIRE_LIVE_PUBLIC_DATA=true
