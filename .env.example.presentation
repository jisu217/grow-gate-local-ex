KATS_CERTIFIED_PRODUCT_FACTORIES_SOURCE_URL=https://www.data.go.kr/data/15040701/fileData.do
KATS_CERTIFIED_PRODUCT_FACTORIES_FILE_PATH=data/public/kats_certified_product_factories_20210823.csv
