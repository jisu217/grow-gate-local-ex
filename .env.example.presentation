MOTIE_SEMICONDUCTOR_DISPLAY_TRENDS_API_KEY=${DATAGO_SERVICE_KEY}
MOTIE_RECALL_DISPOSITIONS_SOURCE_URL=https://www.data.go.kr/data/15054301/fileData.do
MOTIE_RECALL_DISPOSITIONS_FILE_PATH=data/public/motie_product_recall_dispositions_20251231.csv
